# Copier ce fichier en .env puis remplacer TOUTES les valeurs marquées CHANGER.
# Ne jamais versionner .env.

# --- Base de données
MYSQL_ROOT_PASSWORD=CHANGER-mot-de-passe-root-mysql
DB_PASSWORD=CHANGER-mot-de-passe-base

# --- Application
# Au moins 32 caractères aléatoires : openssl rand -base64 48
APP_JWT_SECRET=CHANGER-secret-jwt-de-48-caracteres-minimum-aleatoire
# Mot de passe par défaut des comptes créés au premier démarrage (changement obligatoire à la 1re connexion)
APP_DEFAULT_PASSWORD=Entraide@2026
# Compte administrateur unique
APP_ADMIN_EMAIL=admin@entraide.ma
# Optionnel : mot de passe initial propre à l'admin (sinon le mot de passe par défaut)
APP_ADMIN_PASSWORD=
# Domaine des e-mails des comptes province/région : <province>@entraide.ma
APP_EMAIL_DOMAIN=entraide.ma
# true dès que le site est servi en HTTPS (cookie de session "Secure")
APP_COOKIE_SECURE=false

# --- Réseau / sauvegardes
WEB_PORT=3000
BACKUP_KEEP_DAYS=14
